{
  "aquifers_enabled": false,
  "default_block": {
    "Name": "ryancraft:moonstone"
  },
  "default_fluid": {
    "Name": "minecraft:air"
  },
  "disable_mob_generation": true,
  "legacy_random_source": false,
  "ore_veins_enabled": false,
  "sea_level": 0,
  "spawn_target": [],
  "noise": {
    "height": 256,
    "min_y": 0,
    "size_horizontal": 1,
    "size_vertical": 2
  },
  "noise_router": {
    "barrier": 0.0,
    "continents": 0.0,
    "depth": 0.0,
    "erosion": 0.0,
    "fluid_level_floodedness": 0.0,
    "fluid_level_spread": 0.0,
    "lava": 0.0,
    "preliminary_surface_level": 0.0,
    "ridges": 0.0,
    "temperature": 0.0,
    "vegetation": 0.0,
    "vein_gap": 0.0,
    "vein_ridged": 0.0,
    "vein_toggle": 0.0,
    "final_density": {
      "type": "minecraft:interpolated",
      "argument": {
        "type": "minecraft:add",
        "argument1": {
          "type": "minecraft:y_clamped_gradient",
          "from_y": 40,
          "to_y": 130,
          "from_value": 1.0,
          "to_value": -1.0
        },
        "argument2": {
          "type": "minecraft:add",
          "argument1": {
            "type": "minecraft:mul",
            "argument1": 0.22,
            "argument2": {
              "type": "minecraft:noise",
              "noise": "minecraft:surface",
              "xz_scale": 0.6,
              "y_scale": 0.0
            }
          },
          "argument2": {
            "type": "minecraft:mul",
            "argument1": 0.45,
            "argument2": {
              "type": "minecraft:noise",
              "noise": "minecraft:erosion",
              "xz_scale": 0.35,
              "y_scale": 0.0
            }
          }
        }
      }
    }
  },
  "surface_rule": {
    "type": "minecraft:sequence",
    "sequence": [
      {
        "type": "minecraft:condition",
        "if_true": {
          "type": "minecraft:vertical_gradient",
          "random_name": "minecraft:bedrock_floor",
          "true_at_and_below": {
            "above_bottom": 0
          },
          "false_at_and_above": {
            "above_bottom": 5
          }
        },
        "then_run": {
          "type": "minecraft:block",
          "result_state": {
            "Name": "minecraft:bedrock"
          }
        }
      },
      {
        "type": "minecraft:condition",
        "if_true": {
          "type": "minecraft:vertical_gradient",
          "random_name": "ryancraft:deep_moonstone",
          "true_at_and_below": {
            "absolute": 24
          },
          "false_at_and_above": {
            "absolute": 36
          }
        },
        "then_run": {
          "type": "minecraft:block",
          "result_state": {
            "Name": "ryancraft:deep_moonstone",
            "Properties": {
              "axis": "y"
            }
          }
        }
      },
      {
        "type": "minecraft:condition",
        "if_true": {
          "type": "minecraft:stone_depth",
          "offset": 2,
          "surface_type": "floor",
          "add_surface_depth": true,
          "secondary_depth_range": 0
        },
        "then_run": {
          "type": "minecraft:block",
          "result_state": {
            "Name": "ryancraft:moon_dust"
          }
        }
      }
    ]
  }
}